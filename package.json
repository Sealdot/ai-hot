{
  "name": "ai-hot-mvp",
  "version": "0.9.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "dev": "node --env-file-if-exists=.env.local --watch server.mjs",
    "daily": "node scripts/generate-daily.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "service:install": "node scripts/install-launch-agent.mjs",
    "service:uninstall": "node scripts/install-launch-agent.mjs --uninstall",
    "test": "node --test tests/*.test.mjs",
    "verify:offline": "node scripts/offline-alpha.mjs",
    "demo:offline": "node scripts/offline-alpha.mjs --demo"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
