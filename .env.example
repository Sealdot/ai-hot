# Alpha candidate: use npm run demo:offline for the guarded offline path.
# The packaged catalog has all sources disabled; this example is never loaded
# by the offline acceptance runner. No .env.local is needed.

# This file is entirely optional. AI HOT v0.9 starts with no account or key.
# Without a model, it still collects feeds, deduplicates, applies rule-based
# curation, publishes Web/RSS, and creates daily issues.

# Optional: use a fixed local admin token. If omitted, the service generates
# data/admin-token.runtime with 0600 permissions on first start.
# ADMIN_TOKEN=replace-with-a-long-random-value

# Optional retention limits for a small local footprint (these are the defaults).
# ITEM_RETENTION_DAYS=90
# ISSUE_RETENTION_DAYS=90
# JOB_RETENTION_DAYS=30
# BACKUP_RETENTION_COUNT=3
# MAX_LOG_BYTES=524288

# Optional: higher GitHub API allowance for the built-in release sources.
# Without a token, the scheduler stays below the public hourly quota and
# honors the reset time returned by GitHub.
# GITHUB_TOKEN=github_pat_...

# Optional social/community connectors. These sources remain disabled until
# credentials are configured and you explicitly enable them on the Sources page.
# X_BEARER_TOKEN=...
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# REDDIT_USER_AGENT=AI-Hot/0.9 by your-reddit-username

# Optional: external OpenAI Responses API. Not needed for local-only mode.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=45000

# Optional legacy integrations retained for one version.
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=replace-me
# LLM_ENRICHER_URL=https://your-webhook.example/enrich
# LLM_ENRICHER_TOKEN=replace-me
